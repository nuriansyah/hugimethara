{
  "realm": "hugimethara",
  "enabled": true,
  "displayName": "Hugimethara SSO Test",
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "hugimethara",
      "name": "Hugimethara local SSO",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "hugi-keycloak-dev-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/v1/hugimethara/auth/oidc/callback"
      ],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [{ "name": "engineering" }],
  "users": [
    {
      "username": "sso.user",
      "enabled": true,
      "email": "sso.user@example.test",
      "emailVerified": true,
      "firstName": "SSO",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "correct horse battery", "temporary": false }],
      "groups": ["/engineering"]
    }
  ]
}
